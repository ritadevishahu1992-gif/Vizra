{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/omnia-sync",
      "schedule": "0 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/roadmap",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-and-conditions",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/cookie-policy",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/workspace",
      "permanent": true
    },
    {
      "source": "/crawler-audit",
      "destination": "/seo-diagnostics",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/googlef66bb3a90d865a89.html",
      "destination": "/googlef66bb3a90d865a89.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/og-image.png",
      "destination": "/og-image.png"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(features|tools|studio|explore|pricing|docs|about|contact|terms-and-conditions|privacy-policy|cookie-policy|ai|workspace|history|settings|seo-diagnostics)",
      "destination": "/$1/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=604800" }
      ]
    },
    {
      "source": "/(ai|history|settings|workspace|dashboard|seo-diagnostics|crawler-audit)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
