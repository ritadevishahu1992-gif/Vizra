{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/omnia-sync",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/googlef66bb3a90d865a89.html",
      "destination": "/googlef66bb3a90d865a89.html"
    },
    {
      "source": "/api/(.*)",
