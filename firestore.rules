rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 4096));
    }

    // Validation Blueprint for Project
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'category'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && (!('category' in data) || data.category in ['video', 'animation', 'campaign', 'app', 'research', 'writing', 'general'])
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000))
        && (!('status' in data) || data.status in ['active', 'archived', 'completed']);
    }

    // Validation Blueprint for ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'conversationId', 'role', 'content'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.conversationId is string && data.conversationId.size() > 0 && data.conversationId.size() <= 128
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 20000;
    }

    // User Profile: Strict PII Isolation
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user enumeration strictly denied
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming())
          && incoming().ownerId == userId
          && incoming().id == projectId;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // User Omnia Conversations & Messages
      match /conversations/{conversationId}/messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow update: if false; // Conversation history is immutable
        allow delete: if isOwner(userId) && isValidId(messageId);
      }
    }

    // Connection testing endpoint for boot diagnostic
    match /test/{docId} {
      allow get: if true;
    }
  }
}
