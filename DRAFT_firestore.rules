rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isConsentParty(data) {
      return isSignedIn()
        && data != null
        && (
          ('child_uid' in data && data.child_uid is string && data.child_uid == request.auth.uid)
          || ('parent_uid' in data && data.parent_uid is string && data.parent_uid == request.auth.uid)
        );
    }

    // Validation Blueprint for UserProfile (blocks shadow fields such as ageStatus/consentStatus/role)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 254))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 4096));
    }

    // Validation Blueprint for Project
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'category', 'description', 'status', 'stages', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category in ['video', 'animation', 'campaign', 'app', 'research', 'writing', 'general']
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000))
        && (!('status' in data) || data.status in ['active', 'archived', 'completed'])
        && (!('stages' in data) || (data.stages is list && data.stages.size() <= 25));
    }

    // Validation Blueprint for ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'conversationId', 'role', 'content', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'conversationId', 'role', 'content', 'sources', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.conversationId is string && data.conversationId.size() > 0 && data.conversationId.size() <= 128
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 20000
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 50));
    }

    // User Profile: Strict PII Isolation (parents cannot access child profile or conversations)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user enumeration strictly denied
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(projectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming());
        allow update: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming())
          && incoming().ownerId == userId
          && incoming().id == projectId
          && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // User Omnia Conversations & Messages (strictly owner-only; NOT auto-exposed to parents)
      match /conversations/{conversationId}/messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(conversationId);
        allow create: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow update: if false; // Conversation history is immutable
        allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }

    // Parental Consent Records: Server-authoritative writes only; strictly party-scoped reads
    match /parental_consents/{consentId} {
      allow get: if isValidId(consentId) && isConsentParty(existing());
      allow list: if isConsentParty(existing());
      allow create, update, delete: if false; // Clients can NEVER forge, modify, self-approve, or delete consent records
    }

    // Parent-Child Relationships: Server-authoritative writes only; strictly party-scoped reads
    match /parent_child_relationships/{relationshipId} {
      allow get: if isValidId(relationshipId) && isConsentParty(existing());
      allow list: if isConsentParty(existing());
      allow create, update, delete: if false; // Clients can NEVER create, tamper with, or erase verified relationships
    }

    // Consent Audit Logs: Append-only server-written compliance records; zero client access
    match /consent_audit_logs/{eventId} {
      allow read, write: if false;
    }

    // Connection testing endpoint for boot diagnostic (restricted strictly to docId == 'connection')
    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
