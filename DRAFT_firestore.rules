rules_version = '2';

// ============================================================================
// VIZRA AI CREATIVE STUDIO — HARDENED DRAFT FIRESTORE SECURITY RULES
// ============================================================================
// STATUS: DRAFT — AWAITING EXPLICIT USER APPROVAL BEFORE PRODUCTION DEPLOYMENT
// Project: nice-dolphin-n7c1c
// Database: ai-studio-vizraaicreatives-526756ea-8369-4e64-bb74-541d358e399a
//
// Improvements over current production firestore.rules:
// 1. Enforces isValidId(userId) across all nested subcollections (projects & messages).
// 2. Binds document ID & foreign keys on CREATE (project.id == projectId,
//    message.id == messageId, message.conversationId == conversationId).
// 3. Adds action-based diff().affectedKeys().hasOnly(...) guards on all UPDATE operations.
// 4. Validates timestamp fields (ISO-8601 string <= 40 chars or Firestore Timestamp).
// 5. Enforces https:// prefix on photoURL (prevents stored javascript:/data: URIs).
// 6. Binds profile email to request.auth.token.email when present (prevents email spoofing).
// 7. Explicitly rejects privilege/billing shadow fields (role, isAdmin, plan, planId,
//    subscription, credits) via strict keys().hasOnly(...) allowlists.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Security Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() > 0;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestampValue(val) {
      return (val is string && val.size() >= 10 && val.size() <= 40) || (val is timestamp);
    }

    function isSafeOptionalUrl(val) {
      return val == null || (val is string && val.size() <= 2048 && (val == '' || val.matches('^https://.*')));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Strict Schema Validation: UserProfile
    // Explicitly forbids privilege/subscription fields (role, isAdmin, plan, planId, credits, subscription).
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && (!('email' in data) || data.email == null || (
          data.email is string
          && data.email.size() <= 254
          && (!('email' in request.auth.token) || data.email == request.auth.token.email)
        ))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || isSafeOptionalUrl(data.photoURL))
        && isValidTimestampValue(data.createdAt)
        && isValidTimestampValue(data.lastLoginAt);
    }

    // Strict Schema Validation: Project
    function isValidProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'category', 'description', 'status', 'stages', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == projectId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.category in ['video', 'animation', 'campaign', 'app', 'research', 'writing', 'general']
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000))
        && (!('status' in data) || data.status in ['active', 'archived', 'completed'])
        && (!('stages' in data) || (data.stages is list && data.stages.size() <= 25))
        && isValidTimestampValue(data.createdAt)
        && isValidTimestampValue(data.updatedAt);
    }

    // Strict Schema Validation: ChatMessage
    function isValidChatMessage(data, userId, conversationId, messageId) {
      return data.keys().hasAll(['id', 'userId', 'conversationId', 'role', 'content', 'timestamp'])
        && data.keys().hasOnly(['id', 'userId', 'conversationId', 'role', 'content', 'sources', 'timestamp'])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.conversationId is string && data.conversationId == conversationId && isValidId(data.conversationId)
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() > 0 && data.content.size() <= 20000
        && (!('sources' in data) || (data.sources is list && data.sources.size() <= 50))
        && isValidTimestampValue(data.timestamp);
    }

    // User Profile: Strict PII Isolation & Zero User Enumeration
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId)
        && (!('uid' in existing()) || existing().uid == request.auth.uid);
      allow list: if false; // Blanket user enumeration strictly denied
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'lastLoginAt'])
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(projectId)
          && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(projectId)
          && isValidProject(incoming(), userId, projectId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(projectId)
          && isValidProject(incoming(), userId, projectId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'description', 'status', 'stages', 'updatedAt'])
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(projectId);
      }

      // User Omnia Conversations & Messages (Append-Only Immutable Messages)
      match /conversations/{conversationId}/messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId)
          && existing().userId == request.auth.uid;
        allow list: if isOwner(userId) && isValidId(userId) && isValidId(conversationId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId)
          && isValidChatMessage(incoming(), userId, conversationId, messageId);
        allow update: if false; // Conversation history is strictly immutable
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }

    // Boot Diagnostic Connection Probe (read-only single sentinel document; contains no user/PII data)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }
  }
}
