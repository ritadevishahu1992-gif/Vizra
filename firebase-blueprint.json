{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered Vizra creator profile document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique Firebase Authentication UID matching document ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Creator primary email address",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the creator",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 4096
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was created"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when profile was last signed into or updated"
        }
      },
      "required": ["uid", "email", "createdAt", "lastLoginAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User created creative project in Vizra.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner creator UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Project title",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Creative category",
          "enum": ["video", "animation", "campaign", "app", "research", "writing", "general"],
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "description": "Summary and goals of the creative project",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived", "completed"],
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["id", "ownerId", "title", "category", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Omnia conversation message history item.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"],
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "description": "Message text payload",
          "maxLength": 20000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Message timestamp"
        }
      },
      "required": ["id", "userId", "conversationId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private creator profile document containing user info"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Subcollection of creative projects owned by the user"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Subcollection of Omnia chat history messages for a user conversation"
    }
  }
}
