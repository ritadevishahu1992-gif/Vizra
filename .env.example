# ==============================================================================
# VIZRA ENVIRONMENT CONFIGURATION
# ==============================================================================
# Core HTTP server, landing pages, SEO routes, legal pages, and graceful fallback
# studio features operate cleanly without optional integration credentials.
# Never commit real secrets into this template.

# ------------------------------------------------------------------------------
# 1. CORE AI CONFIGURATION (Required for live Omnia 1.0 AI inference)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side API key for Google Gemini SDK (@google/genai).
# Without a real key, the server boots cleanly and chat degrades gracefully.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. OPTIONAL RUNTIME & HOSTING SETTINGS
# ------------------------------------------------------------------------------
# PORT: HTTP + WebSocket port (defaults to 3000)
PORT="3000"

# NODE_ENV: Runtime mode ("development" | "production")
NODE_ENV="development"

# APP_URL: Canonical public origin used for OAuth callbacks & security alert links
# Defaults to https://vizra.vercel.app if unset.
APP_URL=""

# FIREBASE_PROJECT_ID: Optional server override for Firebase ID token verification.
# Normally auto-resolved from firebase-applet-config.json.
FIREBASE_PROJECT_ID=""

# ------------------------------------------------------------------------------
# 3. FEATURE-DEPENDENT SECURITY, ADMIN & CRON GOVERNANCE
# ------------------------------------------------------------------------------
# ADMIN_API_KEY: Secret protecting /api/omnia/*, /api/safety/reports,
# /api/metrics, /api/seo-diagnostics/*, and /api/engage/admin/*.
# Must be >= 8 characters and not a placeholder value.
# Note: Legacy WORKFLOW_SECRET alias is deprecated; prefer ADMIN_API_KEY.
ADMIN_API_KEY=""

# ADMIN_ALLOWLIST_EMAILS: Comma-separated Firebase Auth verified admin emails
# granted privileged role access via Bearer JWT.
ADMIN_ALLOWLIST_EMAILS=""

# CRON_SECRET: Authenticates scheduled /api/cron/omnia-sync calls (>= 8 chars).
CRON_SECRET=""

# SESSION_HASH_SECRET: HMAC salt for persisted privacy pseudonymization
# (age_assurance_records, safetyReports sessionHash) (>= 16 chars).
# Optional in dev (ephemeral CSPRNG fallback); required in production for cross-restart correlation.
# Note: HTTP rate-limiters use in-memory IP maps and reset across restarts independently.
SESSION_HASH_SECRET=""
# SESSION_HASH_SECRET_PREVIOUS: Optional comma-separated previous secrets for lossless rotation lookup.
SESSION_HASH_SECRET_PREVIOUS=""

# INTEGRATION_TOKEN_SECRET: AES-256-GCM encryption secret for persistent OAuth vault tokens
# (>= 16 chars). Optional in dev (uses non-persisted memory vault); REQUIRED in production (fail-closed).
INTEGRATION_TOKEN_SECRET=""
# INTEGRATION_TOKEN_SECRET_PREVIOUS: Optional comma-separated previous vault secrets for seamless re-encryption.
INTEGRATION_TOKEN_SECRET_PREVIOUS=""

# ------------------------------------------------------------------------------
# 4. OPTIONAL TRANSACTIONAL EMAIL (Resend SDK — Simulated mode when omitted)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
VIZRA_EMAIL_FROM="VIZRA Security <onboarding@resend.dev>"
VIZRA_ADMIN_NOTIFICATION_EMAIL=""

# ------------------------------------------------------------------------------
# 5. OPTIONAL CONSENT AUDIT EXPORT (Google Sheets API v4 or Webhook)
# ------------------------------------------------------------------------------
# Option A: HTTPS Webhook Endpoint
GOOGLE_SHEETS_CONSENT_WEBHOOK_URL=""
GOOGLE_SHEETS_WEBHOOK_SECRET=""

# Option B: Google Sheets API v4 via Service Account JWT
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_RANGE="ConsentLogs!A:L"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 6. FEATURE-DEPENDENT WORKSPACE OAUTH CONNECTORS
# ------------------------------------------------------------------------------
# Each connector activates independently only when BOTH Client ID and Client Secret
# are configured. Google Drive, Docs, Sheets & YouTube share the 1P Google pair.
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_NOTION_CLIENT_ID=""
OAUTH_NOTION_CLIENT_SECRET=""
OAUTH_FIGMA_CLIENT_ID=""
OAUTH_FIGMA_CLIENT_SECRET=""
OAUTH_CANVA_CLIENT_ID=""
OAUTH_CANVA_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. FEATURE-DEPENDENT COMPLIANCE & PUBLIC OPERATOR DISCLOSURES (REC-13)
# ------------------------------------------------------------------------------
# Public client configuration (compiled into bundle ONLY after legal sign-off)
VITE_LEGAL_ENTITY_NAME=""
VITE_LEGAL_REGISTERED_ADDRESS=""
VITE_DPO_EMAIL=""
VITE_GOVERNING_LAW=""

# Child Online Safety — External Verifiable Parental Consent Vendor (Option 3)
# Remains fail-closed (HTTP 424) unless all three are configured by counsel.
PARENTAL_CONSENT_PROVIDER=""
PARENTAL_CONSENT_API_KEY=""
PARENTAL_CONSENT_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 8. UNUSED EXTERNAL DEPENDENCY PLACEHOLDERS (STATUS REPORTING ONLY)
# ------------------------------------------------------------------------------
# Classified as UNUSED: No Cision API client or external integration exists in VIZRA.
# Checked solely by /api/config/status and /api/compliance/status for compliance reporting.
CISION_API_KEY=""
CISION_CLIENT_SECRET=""
