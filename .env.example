# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CRON_SECRET: Used by Vercel Cron to authenticate scheduled synchronization calls (/api/cron/omnia-sync)
CRON_SECRET="your_vercel_cron_secret"

# ADMIN_API_KEY: Protects administrative training endpoints
ADMIN_API_KEY="your_admin_api_key"

# WORKFLOW_SECRET: Used for securing Vercel Workflows execution hooks
WORKFLOW_SECRET="your_workflow_secret"

# VIZRA LOGIN NOTIFICATION SYSTEM (Phase 2 & 6)
# RESEND_API_KEY: Server-side API key for Resend transactional email dispatch.
# If omitted, notifications run in secure local simulation mode without outbound network calls.
RESEND_API_KEY="re_placeholder_key"

# VIZRA_EMAIL_FROM: Verified sender email address formatted per RFC 5322
VIZRA_EMAIL_FROM="VIZRA Security <onboarding@resend.dev>"

# VIZRA_ADMIN_NOTIFICATION_EMAIL: Recipient address for platform administrator security alerts
VIZRA_ADMIN_NOTIFICATION_EMAIL="security-admin@vizra.ai"

# VIZRA CONSENT RECORDKEEPING — OPTIONAL GOOGLE SHEETS AUDIT EXPORT
# Option A: Google Apps Script / Webhook endpoint (HTTPS URL)
GOOGLE_SHEETS_CONSENT_WEBHOOK_URL="your_google_sheets_webhook_url"
GOOGLE_SHEETS_WEBHOOK_SECRET="your_optional_webhook_secret"

# Option B: Direct Google Sheets API v4 via Service Account JWT
GOOGLE_SHEETS_SPREADSHEET_ID="your_spreadsheet_id"
GOOGLE_SHEETS_RANGE="ConsentLogs!A:L"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

